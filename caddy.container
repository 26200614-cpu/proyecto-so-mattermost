[Unit]
Description=Caddy proxy HTTPS
After=mm.service

[Container]
Image=docker.io/library/caddy:2
ContainerName=caddy
Network=mmnet.network
PublishPort=80:80
PublishPort=443:443
Volume=%h/mm/Caddyfile:/etc/caddy/Caddyfile:Z
Volume=%h/mm/caddy_data:/data:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
