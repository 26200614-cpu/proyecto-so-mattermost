[Unit]
Description=Mattermost
After=db.service
Requires=db.service

[Container]
Image=docker.io/mattermost/mattermost-team-edition:latest
ContainerName=mm
Network=mmnet.network
Volume=%h/mm/config:/mattermost/config:Z,U
Volume=%h/mm/data:/mattermost/data:Z,U
Volume=%h/mm/logs:/mattermost/logs:Z,U
Volume=%h/mm/plugins:/mattermost/plugins:Z,U
Environment=MM_SQLSETTINGS_DRIVERNAME=postgres
Environment=MM_SQLSETTINGS_DATASOURCE=postgres://mmuser:CAMBIAR@db:5432/mattermost?sslmode=disable
Environment=MM_SERVICESETTINGS_SITEURL=https://reinicia-y-reza.duckdns.org

[Service]
Restart=always

[Install]
WantedBy=default.target
